# ==============================================================================
# Cloud IDS - .gitignore
# ==============================================================================

# Environment variables - NEVER commit
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.Python
pip-wheel-metadata/

# Virtual environments
venv/
env/
.venv/
ENV/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Logs
logs/*.log
logs/*.gz

# Database
*.db
*.sqlite3

# Testing
.pytest_cache/
.coverage
htmlcov/

# Docker
*.dockerignore

# OS
.DS_Store
Thumbs.db
desktop.ini
