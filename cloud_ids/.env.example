# ==============================================================================
# Cloud IDS - Environment Variable Template
# Copy this file to .env and fill in your real values.
# ==============================================================================

FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=CHANGE_ME

DB_USERNAME=postgres
DB_PASSWORD=CHANGE_ME
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cloud_ids_db
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/cloud_ids_db

JWT_SECRET_KEY=CHANGE_ME
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=86400

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=CHANGE_ME
MAIL_PASSWORD=CHANGE_ME
MAIL_DEFAULT_SENDER=CHANGE_ME
ALERT_EMAIL_RECIPIENT=CHANGE_ME

CAPTURE_INTERFACE=Ethernet
CAPTURE_FILTER=ip
PACKET_BUFFER_SIZE=10000

PORT_SCAN_THRESHOLD=20
PORT_SCAN_WINDOW=10
BRUTE_FORCE_THRESHOLD=5
BRUTE_FORCE_WINDOW=60
DDOS_THRESHOLD=1000
DDOS_WINDOW=1
TRAFFIC_SPIKE_MULTIPLIER=3

ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@cloudids.local
ADMIN_PASSWORD=CHANGE_ME

LOG_LEVEL=DEBUG
LOG_FILE=logs/cloud_ids.log

BCRYPT_LOG_ROUNDS=12
MFA_ENABLED=True
MFA_ISSUER=CloudIDS

AWS_REGION=us-east-1
AWS_S3_BUCKET=cloud-ids-backups
