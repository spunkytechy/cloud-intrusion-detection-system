# ==============================================================================
# Cloud IDS - Environment Variable Template
# Copy this file to .env and fill in your real values.
# ==============================================================================

FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=CHANGE_ME

DB_USERNAME=postgres
DB_PASSWORD=CHANGE_ME
DB_HOST=database-1.ctoyw2yg2ulo.eu-west-2.rds.amazonaws.com
DB_PORT=5432
DB_NAME=postgres
# URL-encode reserved characters in DB_PASSWORD, for example # as %23.
DATABASE_URL=postgresql+psycopg2://postgres:CHANGE_ME@database-1.ctoyw2yg2ulo.eu-west-2.rds.amazonaws.com:5432/postgres

JWT_SECRET_KEY=CHANGE_ME
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=86400

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=CHANGE_ME
MAIL_PASSWORD=CHANGE_ME
MAIL_DEFAULT_SENDER=CHANGE_ME
ALERT_EMAIL_RECIPIENT=CHANGE_ME

# --- Packet Capture -----------------------------------------------------------
# Master switch. Set to False to run the web UI only (no Scapy sniffer).
# Useful on machines without Npcap / admin rights, or in CI.
ENABLE_PACKET_CAPTURE=True

# Windows: set to the exact adapter name shown in "Get-NetAdapter" (e.g. Wi-Fi,
# Ethernet, Ethernet 2). Leave blank to let Scapy pick a default.
# Linux/macOS: use the kernel name, e.g. eth0, en0, wlp3s0.
CAPTURE_INTERFACE=Ethernet

# BPF-style capture filter. "ip" captures all IPv4 traffic.
CAPTURE_FILTER=ip

# Sniffer → analyzer queue size. Packets are dropped once full.
PACKET_BUFFER_SIZE=10000

# --- Analyzer batching --------------------------------------------------------
# The analyzer buffers TrafficLog rows and flushes them to the DB in bulk.
# Flush happens on whichever comes first: ANALYZER_BATCH_SIZE rows, or
# ANALYZER_FLUSH_INTERVAL seconds elapsed since the last flush.
ANALYZER_BATCH_SIZE=50
ANALYZER_FLUSH_INTERVAL=2.0

# --- Suspicious IP registry ---------------------------------------------------
# When a detector fires, the source IP is marked suspicious for this many
# seconds. All new packets from that IP land in traffic_logs as 'suspicious'.
SUSPICIOUS_IP_TTL_SECONDS=300
# When a detector fires, existing traffic_logs rows from the offending IP
# within this many seconds are back-written to 'suspicious' too.
SUSPICIOUS_BACKFILL_WINDOW_SECONDS=300

# --- Windows Scapy prerequisites ---------------------------------------------
# 1. Install Npcap: https://npcap.com/  (WinPcap-compatible mode is fine)
# 2. Run the Python process as Administrator (raw socket access).
# 3. CAPTURE_INTERFACE above must match a real adapter or be left blank.
# The dashboard shows a banner and the reason when capture is not running.

PORT_SCAN_THRESHOLD=20
PORT_SCAN_WINDOW=10
BRUTE_FORCE_THRESHOLD=5
BRUTE_FORCE_WINDOW=60
DDOS_THRESHOLD=1000
DDOS_WINDOW=1
TRAFFIC_SPIKE_MULTIPLIER=3

ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@cloudids.local
ADMIN_PASSWORD=CHANGE_ME

LOG_LEVEL=DEBUG
LOG_FILE=logs/cloud_ids.log

BCRYPT_LOG_ROUNDS=12
MFA_ENABLED=True
MFA_ISSUER=CloudIDS

AWS_REGION=us-east-1
AWS_S3_BUCKET=cloud-ids-backups
